# Root .env — read by docker compose
POSTGRES_USER=jobfinder
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jobfinder

# Outbound mail via the `smtp` (postfix) service.
# Relay mode (recommended): send through Gmail/Outlook with an app password.
ALLOWED_SENDER_DOMAINS=example.com
RELAYHOST=[smtp.gmail.com]:587
RELAYHOST_USERNAME=
RELAYHOST_PASSWORD=
# Optional host port overrides
# API_PORT=8100
# WEB_PORT=8180

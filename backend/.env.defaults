# Every setting the backend reads, with its default. Committed; never put a secret here.
#
# Precedence (later wins): this file, then backend/.env (gitignored: secrets and local overrides),
# then the process environment (compose `environment:`, a k8s ConfigMap/Secret).
# jobfinder/core/config.py declares the same keys, in the same order, with types only: a key missing
# from all three stops startup with the list of missing keys, and tests/test_core_config.py fails when
# this file and Settings disagree. Keep comments on their own lines (not after a value).

# ── Database ─────────────────────────────────────────────────────────────────
# An explicit URL wins. Empty: built from the POSTGRES_* parts below, with the user and password
# percent-encoded (compose passes parts because it can't encode a password with @ / %).
DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=jobfinder
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jobfinder

# ── App ──────────────────────────────────────────────────────────────────────
# Required, set it in backend/.env: 32+ random characters, signs email links. Generate with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Where email links point. Production: https://<SITE_ADDRESS> (https also makes the session cookie Secure).
PUBLIC_BASE_URL=http://localhost:8180
# Document file store (a docker volume in compose: /data/store)
STORE_DIR=./store
# Largest document upload, in bytes (10 MiB)
UPLOAD_MAX_BYTES=10485760
# true: read uploads and fetch links inside the request, as before #51 (kept for one release). false: the
# api saves them as "processing" and worker-io's parse_document / fetch_link tasks finish them
SYNC_UPLOADS=false
# Log level of the worker and renderer processes: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
SESSION_TTL_DAYS=30

# ── AI: the Claude Code CLI on a subscription (no API key) ──────────────────
CLAUDE_BIN=claude
CLAUDE_SCRATCH_DIR=/tmp
# Fallback token from `claude setup-token`; a token saved on the admin "AI setup" page wins.
# Empty on a dev machine: the CLI's own login is used.
CLAUDE_CODE_OAUTH_TOKEN=
# Credentials volume shared by api and worker (compose: /data/claude)
CLAUDE_AUTH_DIR=./claude-auth
# Claude calls (and worker tasks) at once
AI_MAX_CONCURRENCY=2
# Characters of profile sources, and of a job description, sent to the model
AI_MAX_SOURCE_CHARS=30000
AI_MAX_JOB_CHARS=12000
# Model per task: haiku | sonnet | opus
AI_CHECK_MODEL=haiku
PROFILE_MODEL=sonnet
FOLLOWUP_MODEL=sonnet
AUDIT_MODEL=sonnet
MATCH_MODEL=sonnet
LETTER_MODEL=sonnet
QUESTIONS_MODEL=sonnet
RESUME_MODEL=sonnet
RECIPE_MODEL=sonnet

# ── Email (plain SMTP; compose: the `smtp` postfix service, SMTP_HOST=smtp) ──
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
EMAIL_FROM="JobFinder <jobs@localhost>"

# ── Sources ──────────────────────────────────────────────────────────────────
# Optional: raises the GitHub API rate limit for profile import
GITHUB_TOKEN=
# Opt-in LinkedIn/Indeed scraping via python-jobspy (needs the jobspy extra in the worker image)
ENABLE_JOBSPY=false
JOBSPY_MAX_QUERIES=10
JOBSPY_RESULTS_PER_QUERY=25
# Opt-in US federal jobs: set both (free key at developer.usajobs.gov; the email is sent as the User-Agent)
USAJOBS_API_KEY=
USAJOBS_EMAIL=
USAJOBS_MAX_LOCATIONS=10
# Pages of 500 results per query
USAJOBS_MAX_PAGES=4
USAJOBS_DAYS_POSTED=30

# ── Ingestion ────────────────────────────────────────────────────────────────
# The worker runs ingestion, the planner and the daily emails on a schedule
SCHEDULER_ENABLED=true
# Hours between full runs: every board when ADAPTIVE_SCHEDULE_ENABLED=false, and the jobspy/USAJobs gate
INGEST_INTERVAL_HOURS=6
# Adaptive cadence: tick often and fetch only the boards that are due
ADAPTIVE_SCHEDULE_ENABLED=true
INGEST_TICK_MINUTES=15
# Busiest top-tier boards
INGEST_MIN_INTERVAL_MINUTES=60
# Quiet boards, and the failure backoff cap (a week)
INGEST_MAX_INTERVAL_MINUTES=10080
# A board with about one new posting a day
INGEST_BASE_INTERVAL_MINUTES=360
# New postings per 7 days that earn the base interval (about one a day)
INGEST_CHURN_PIVOT=7
# Up to this fraction of a board's interval is added, fixed per board, to spread fetches out
INGEST_JITTER=0.2
INGEST_CONCURRENCY=10
# A board failing this many runs in a row is disabled (re-enable it on the admin page); 0 = never
INGEST_MAX_CONSECUTIVE_FAILURES=5
# Discovered (non-seed) boards fetched per run, chosen by users' targets; seed boards always run; 0 = no cap
INGEST_MAX_DISCOVERED_BOARDS_PER_RUN=300

# ── Discovery, job links, coverage, resolver, renderer ──────────────────────
# Weekly board discovery from public directories (honours robots.txt and each site's terms)
DISCOVERY_ENABLED=true
# New boards validated (one live fetch each) per run
DISCOVERY_MAX_CANDIDATES=300
# Users may paste job links; the board behind each one is added for everyone
JOB_LINKS_ENABLED=true
JOB_LINKS_PER_USER_DAY=20
# Weekly coveted score and coverage audit
COVERAGE_ENABLED=true
COVERAGE_RESOLVES_PER_RUN=20
# Last resolver rung: Claude proposes a recipe for an unknown career site
RESOLVER_LLM_ENABLED=true
# Rung 4.5: the opt-in Playwright container (compose profile "renderer")
RENDERER_ENABLED=false
# Boards that need the browser on every fetch (rendered_html recipes)
RENDERER_MAX_RENDERED_BOARDS=25
# Renderer container: browser contexts at once (each is capped in time and bytes), and its queue poll
RENDERER_CONCURRENCY=2
RENDERER_POLL_SECONDS=2

# ── Matching, digest, questions ──────────────────────────────────────────────
# LLM-scored jobs per user per rolling 24h (a user's own setting wins)
MATCH_DAILY_LLM_BUDGET=25
# Candidates scoring below this (0-100) never reach the LLM
MATCH_MIN_PREFILTER=20.0
# Only matches at least this good go into the daily email
DIGEST_MIN_SCORE=65
DIGEST_MAX_MATCHES=10
# If the worker was down at a user's chosen hour, still send within this many hours after it
DIGEST_SEND_WINDOW_HOURS=6
QUESTIONS_PER_EMAIL=6
# Stop collecting new questions while this many are unanswered
MAX_OPEN_QUESTIONS=15
# Collect each user's questions this many hours before their daily email; 0 turns it off (#50)
QUESTIONS_LEAD_HOURS=1

# ── Background planner ───────────────────────────────────────────────────────
# How often it looks for users who need work
PLANNER_INTERVAL_MINUTES=15
# Users planned per tick, counting work already queued or running
PLANNER_MAX_PER_TICK=3
# Gap between the start times of users planned in one tick
PLANNER_STAGGER_SECONDS=120
# Minimum gap between runs for a recently active user
PLANNER_MIN_INTERVAL_HOURS=3
# Pause all planning after a rate-limit or auth error from Claude
PLANNER_BACKOFF_MINUTES=30

# ── Task queue and worker loop ───────────────────────────────────────────────
TASK_MAX_ATTEMPTS=3
# A running task with no heartbeat for this long is queued again (or failed after TASK_MAX_ATTEMPTS)
TASK_STUCK_AFTER_MINUTES=5
# Retry delay after the first failed attempt; it grows 4x per attempt (30s, 2m, 8m)
TASK_BACKOFF_SECONDS=30
# How often a running task refreshes its lock (keep well under TASK_STUCK_AFTER_MINUTES)
TASK_HEARTBEAT_SECONDS=60
# Done and failed tasks are deleted this many days after they finished
TASK_PRUNE_DAYS=30
# Queue poll when idle, and how often stuck tasks, old tasks, rate events and sessions are cleaned up
WORKER_POLL_SECONDS=2
WORKER_REAP_SECONDS=60

# ── Task platform (#48): Postgres ledger, valkey delivery ────────────────────
# legacy: the single poll-loop worker (python -m jobfinder.worker) runs everything.
# ledger: the scheduler, worker-ai, worker-io and the renderer consume valkey streams.
TASKS_BACKEND=legacy
VALKEY_URL=redis://valkey:6379/0
# Tasks one worker-io process runs at once (worker-ai: AI_MAX_CONCURRENCY; render: RENDERER_CONCURRENCY)
WORKER_IO_CONCURRENCY=10
# How often the scheduler's relay publishes due tasks that are still queued
RELAY_SECONDS=15

# ── Auth limits ──────────────────────────────────────────────────────────────
# Minutes a set/reset-password link stays valid
PASSWORD_LINK_TTL_MINUTES=60
LINK_REQUESTS_PER_EMAIL_HOUR=3
LINK_COOLDOWN_SECONDS=60
LINK_REQUESTS_PER_IP_HOUR=10
LOGIN_FAILURES_PER_EMAIL=10
LOGIN_FAILURES_PER_IP=30
LOGIN_FAILURE_WINDOW_MINUTES=15
PREVIEW_EMAILS_PER_HOUR=5

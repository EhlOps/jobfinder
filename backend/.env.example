# App runtime config (copy to backend/.env)
# Required, 32+ random characters (the app refuses to start without it). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Minutes a set/reset-password link stays valid
PASSWORD_LINK_TTL_MINUTES=60
# Production: https://<SITE_ADDRESS>. An https URL also makes the session cookie Secure.
PUBLIC_BASE_URL=http://localhost:8180

# AI: runs the Claude Code CLI (your subscription, no API key).
# Easiest: sign in as the admin and paste your `claude setup-token` token on the "AI setup" page.
# Fallback: set it here instead.
CLAUDE_CODE_OAUTH_TOKEN=
# Admin emails (comma-separated). This is the only way to be admin.
ADMIN_EMAILS=
AI_MAX_CONCURRENCY=2

# Email: plain SMTP. Dev: Mailpit (docker compose --profile dev). Prod: the `smtp` postfix service
# (SMTP_HOST=smtp, SMTP_PORT=587, and a real EMAIL_FROM on your ALLOWED_SENDER_DOMAINS).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
EMAIL_FROM=JobFinder <jobs@localhost>

# Opt-in LinkedIn/Indeed scraping via python-jobspy (ToS-violating, fragile)
ENABLE_JOBSPY=false

# Scheduling (worker): ingest boards every N hours; the daily email goes out at each user's chosen hour.
SCHEDULER_ENABLED=true
INGEST_INTERVAL_HOURS=6
# Disable a company board after this many consecutive failed fetches (re-enable it from the admin page). 0 turns auto-disable off.
INGEST_MAX_CONSECUTIVE_FAILURES=5
# Most discovered (non-seed) boards fetched per ingest run, chosen by users' targets and rotated; seed boards always run. 0 = no cap.
INGEST_MAX_DISCOVERED_BOARDS_PER_RUN=100
# Background planner: how often it looks for users who need work, how many it plans per tick,
# the gap between their start times, the minimum gap for active users, and the pause after a Claude rate limit.
PLANNER_INTERVAL_MINUTES=15
PLANNER_MAX_PER_TICK=3
PLANNER_STAGGER_SECONDS=120
PLANNER_MIN_INTERVAL_HOURS=3
PLANNER_BACKOFF_MINUTES=30

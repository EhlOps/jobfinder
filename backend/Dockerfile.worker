# worker image: Python + Node + the `claude` CLI (used for all AI calls).
FROM python:3.11-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/usr/local

COPY --from=ghcr.io/astral-sh/uv:0.5 /uv /uvx /bin/

RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq5 nodejs npm tini \
    && npm install -g @anthropic-ai/claude-code \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 10001 jobfinder
WORKDIR /app

# Opt-in LinkedIn/Indeed scraping (heavy: pandas/numpy). Build with WITH_JOBSPY=true in the root .env.
ARG WITH_JOBSPY=false

COPY pyproject.toml uv.lock* ./
RUN uv sync --no-dev --no-install-project $([ "$WITH_JOBSPY" = "true" ] && echo "--extra jobspy")

COPY jobfinder ./jobfinder
RUN uv sync --no-dev $([ "$WITH_JOBSPY" = "true" ] && echo "--extra jobspy") \
    && mkdir -p /data/store /data/claude /tmp/claude-scratch \
    && chown -R jobfinder:jobfinder /app /data /tmp/claude-scratch

USER jobfinder
ENV CLAUDE_SCRATCH_DIR=/tmp/claude-scratch
ENTRYPOINT ["tini", "--"]
CMD ["python", "-m", "jobfinder.worker"]

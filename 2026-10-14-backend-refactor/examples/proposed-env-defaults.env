# Sketch (v2): backend/.env.defaults (D4). Committed. Every setting the app reads is listed here with its
# default and a one-line explanation. backend/.env (gitignored) overrides any key and holds the secrets.
# core/config.py declares the same keys with types only; a key missing from both files stops startup.
# Names are today's env var names; the groups below are only comments.

# --- database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB / SECRET_KEY: set in .env, never here

# --- broker (new)
VALKEY_URL=redis://valkey:6379/0

# --- scheduler + workers (new: were constants in worker.py and scheduling/queue.py)
SCHEDULER_RELAY_SECONDS=15          # how often due ledger rows are (re)sent to valkey
SCHEDULER_RESEND_AFTER_MINUTES=10   # a queued row sent this long ago and not claimed is sent again
SCHEDULER_REAP_SECONDS=60
TASK_STUCK_AFTER_MINUTES=5          # running with no heartbeat this long -> queued again
TASK_HEARTBEAT_SECONDS=60
TASK_MAX_ATTEMPTS=3
TASK_BACKOFF_SECONDS=30,120,480
WORKER_AI_CONCURRENCY=2             # was AI_MAX_CONCURRENCY (kept as an alias)
WORKER_IO_CONCURRENCY=10
RENDERER_CONCURRENCY=2

# --- AI (new: model names were hard-coded in ai/tasks.py)
CLAUDE_BIN=claude
MATCH_MODEL=sonnet
RECIPE_MODEL=sonnet
PROFILE_MODEL=sonnet
LETTER_MODEL=sonnet
QUESTIONS_MODEL=haiku
AI_MAX_SOURCE_CHARS=30000
AI_MAX_JOB_CHARS=12000

# --- ingestion (existing names)
INGEST_TICK_MINUTES=15
INGEST_MIN_INTERVAL_MINUTES=60
INGEST_MAX_INTERVAL_MINUTES=10080
INGEST_BASE_INTERVAL_MINUTES=360
INGEST_CHURN_PIVOT=7                # new: was ingest/schedule.py CHURN_PIVOT
INGEST_JITTER=0.2                   # new: was ingest/schedule.py JITTER

# --- api limits (new: were constants in api/*.py)
UPLOAD_MAX_BYTES=10485760
COVER_LETTER_MAX_CHARS=10000
